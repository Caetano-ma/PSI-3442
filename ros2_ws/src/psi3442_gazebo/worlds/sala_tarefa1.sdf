<?xml version="1.0"?>
<!--
  Sala da Tarefa 1 (Gazebo Harmonic). Referencial do mundo: origem em A no piso, x de A para B, y de A para D,
  z para cima (= ReferencialLocal do modelo SysML). Em termos de "bússola", o nariz da aeronave (+x) aponta para
  o leste (guinada 90°), de modo que a conversão norte/leste -> local é exercitada com psi0 diferente de zero.

  O drone é caixa-preta: o modelo não simula hélices nem o firmware DJI. O sistema VelocityControl aplica a
  velocidade comandada pelo app ponte simulado (que já inclui a resposta de 1ª ordem da estabilização); a gravidade
  do corpo está desligada (o firmware sustenta a aeronave) e a colisão com o piso fica ativa.
  Dimensões aproximadas do Mini 4 Pro desdobrado, com hélices: 0,298 m x 0,373 m x 0,101 m (verificar no manual).
-->
<sdf version="1.9">
  <world name="sala_tarefa1">
    <physics name="passo_4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.80 0.85 0.90</background_color>
        <camera_pose>-1.3 -1.5 2.9 0 0.52 0.83</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.80 0.85 0.90 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="luz_teto">
      <cast_shadows>true</cast_shadows>
      <pose>0.75 0.75 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.2 0.3 -0.93</direction>
    </light>

    <!-- piso texturizado (H1), fitas sob o quadrado, marcas A-D e seta de A para B -->
    <model name="piso">
      <static>true</static>
      <link name="link">
        <collision name="colisao">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
        </collision>
        <visual name="tapete">
          <pose>0.75 0.75 0 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <material><ambient>0.55 0.50 0.42 1</ambient><diffuse>0.55 0.50 0.42 1</diffuse></material>
        </visual>
        <visual name="fita_ab"><pose>0.75 0 0.001 0 0 0</pose><geometry><box><size>1.5 0.05 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="fita_bc"><pose>1.5 0.75 0.001 0 0 0</pose><geometry><box><size>0.05 1.5 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="fita_cd"><pose>0.75 1.5 0.001 0 0 0</pose><geometry><box><size>1.5 0.05 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="fita_da"><pose>0 0.75 0.001 0 0 0</pose><geometry><box><size>0.05 1.5 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="marca_A"><pose>0 0 0.002 0 0 0</pose><geometry><box><size>0.40 0.40 0.002</size></box></geometry><material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual>
        <visual name="marca_B"><pose>1.5 0 0.002 0 0 0</pose><geometry><box><size>0.25 0.25 0.002</size></box></geometry><material><ambient>0.15 0.65 0.20 1</ambient><diffuse>0.15 0.65 0.20 1</diffuse></material></visual>
        <visual name="marca_C"><pose>1.5 1.5 0.002 0 0 0</pose><geometry><box><size>0.25 0.25 0.002</size></box></geometry><material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse></material></visual>
        <visual name="marca_D"><pose>0 1.5 0.002 0 0 0</pose><geometry><box><size>0.25 0.25 0.002</size></box></geometry><material><ambient>0.90 0.75 0.10 1</ambient><diffuse>0.90 0.75 0.10 1</diffuse></material></visual>
        <visual name="seta_A_para_B"><pose>0.42 0 0.003 0 0 0</pose><geometry><box><size>0.45 0.03 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- paredes do fundo (as da frente ficam abertas para a câmera) e régua vertical em A (T01) -->
    <model name="paredes">
      <static>true</static>
      <link name="link">
        <collision name="parede_x"><pose>3.25 0.75 1.25 0 0 0</pose><geometry><box><size>0.1 5 2.5</size></box></geometry></collision>
        <visual name="parede_x"><pose>3.25 0.75 1.25 0 0 0</pose><geometry><box><size>0.1 5 2.5</size></box></geometry><material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <collision name="parede_y"><pose>0.75 3.25 1.25 0 0 0</pose><geometry><box><size>5 0.1 2.5</size></box></geometry></collision>
        <visual name="parede_y"><pose>0.75 3.25 1.25 0 0 0</pose><geometry><box><size>5 0.1 2.5</size></box></geometry><material><ambient>0.88 0.90 0.92 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
        <visual name="regua"><pose>-0.35 0 0.95 0 0 0</pose><geometry><box><size>0.03 0.03 1.9</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="regua_170"><pose>-0.35 0 1.70 0 0 0</pose><geometry><box><size>0.10 0.035 0.012</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="regua_180"><pose>-0.35 0 1.80 0 0 0</pose><geometry><box><size>0.16 0.035 0.015</size></box></geometry><material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
        <visual name="regua_190"><pose>-0.35 0 1.90 0 0 0</pose><geometry><box><size>0.10 0.035 0.012</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- volumes de tolerância de P05 em cada vértice: raio 0,30 m, altura 2 x 0,10 m, centrados a 1,80 m -->
    <model name="tolerancias_p05">
      <static>true</static>
      <link name="link">
        <visual name="tol_A"><pose>0 0 1.8 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>0.20</length></cylinder></geometry><transparency>0.7</transparency><cast_shadows>false</cast_shadows><material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual>
        <visual name="tol_B"><pose>1.5 0 1.8 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>0.20</length></cylinder></geometry><transparency>0.7</transparency><cast_shadows>false</cast_shadows><material><ambient>0.15 0.65 0.20 1</ambient><diffuse>0.15 0.65 0.20 1</diffuse></material></visual>
        <visual name="tol_C"><pose>1.5 1.5 1.8 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>0.20</length></cylinder></geometry><transparency>0.7</transparency><cast_shadows>false</cast_shadows><material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse></material></visual>
        <visual name="tol_D"><pose>0 1.5 1.8 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>0.20</length></cylinder></geometry><transparency>0.7</transparency><cast_shadows>false</cast_shadows><material><ambient>0.90 0.75 0.10 1</ambient><diffuse>0.90 0.75 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <!-- aeronave (caixa-preta). Origem do modelo no plano inferior do corpo: z do modelo = altura de P01. -->
    <model name="mini4pro">
      <pose>0 0 0 0 0 0</pose>
      <link name="corpo">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.05 0 0 0</pose>
          <mass>0.249</mass>
          <inertia><ixx>0.0012</ixx><iyy>0.0010</iyy><izz>0.0020</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="envelope">
          <pose>0 0 0.0505 0 0 0</pose>
          <geometry><box><size>0.298 0.373 0.101</size></box></geometry>
        </collision>
        <visual name="fuselagem">
          <pose>0 0 0.045 0 0 0</pose>
          <geometry><box><size>0.17 0.09 0.06</size></box></geometry>
          <material><ambient>0.35 0.36 0.38 1</ambient><diffuse>0.35 0.36 0.38 1</diffuse></material>
        </visual>
        <visual name="camera_frontal">
          <pose>0.10 0 0.03 0 0 0</pose>
          <geometry><sphere><radius>0.022</radius></sphere></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="led_nariz">
          <pose>0.087 0 0.07 0 0 0</pose>
          <geometry><box><size>0.01 0.05 0.01</size></box></geometry>
          <material><ambient>1 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse><emissive>1 0 0 1</emissive></material>
        </visual>
        <visual name="braco_fe"><pose>0.055 0.075 0.06 0 0 0.94</pose><geometry><box><size>0.17 0.018 0.012</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <visual name="braco_fd"><pose>0.055 -0.075 0.06 0 0 -0.94</pose><geometry><box><size>0.17 0.018 0.012</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <visual name="braco_te"><pose>-0.055 0.075 0.06 0 0 -0.94</pose><geometry><box><size>0.17 0.018 0.012</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <visual name="braco_td"><pose>-0.055 -0.075 0.06 0 0 0.94</pose><geometry><box><size>0.17 0.018 0.012</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <visual name="helice_fe"><pose>0.11 0.15 0.085 0 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.004</length></cylinder></geometry><transparency>0.5</transparency><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
        <visual name="helice_fd"><pose>0.11 -0.15 0.085 0 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.004</length></cylinder></geometry><transparency>0.5</transparency><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
        <visual name="helice_te"><pose>-0.11 0.15 0.085 0 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.004</length></cylinder></geometry><transparency>0.5</transparency><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
        <visual name="helice_td"><pose>-0.11 -0.15 0.085 0 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.004</length></cylinder></geometry><transparency>0.5</transparency><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
